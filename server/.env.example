# Copy this file to .env and fill in your own values. Never commit the real .env.

PORT=8787

# Any OpenAI-compatible chat-completions endpoint works out of the box:
#   OpenRouter (free tier):  https://openrouter.ai/api/v1/chat/completions
#   Groq (free tier):        https://api.groq.com/openai/v1/chat/completions
#   OpenAI:                  https://api.openai.com/v1/chat/completions
#   Ollama (local, no key):  http://localhost:11434/v1/chat/completions
LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_API_KEY=your-api-key-here
LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Gemini uses a different request/response shape, so it's handled separately.
# Set LLM_PROVIDER=gemini and fill these instead of the OpenAI-style vars above.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-api-key-here
# GEMINI_MODEL=gemini-1.5-flash
